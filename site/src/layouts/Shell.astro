---
import '../styles/global.scss';
import BrandLogo from '../components/BrandLogo.astro';
import CopyPageMarkdownToolbar from '../components/CopyPageMarkdownToolbar.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import PagefindToolbarTrigger from '../components/PagefindToolbarTrigger.astro';
import RailNavSections from '../components/RailNavSections.astro';
import ThemeToggleHint from '../components/ThemeToggleHint.astro';
import pagefindLoaderUrl from '../scripts/pagefind-loader.ts?url';
import shellAfterLoadUrl from '../scripts/shell-after-load.ts?url';
import themeBootUrl from '../scripts/theme-boot.ts?url';
import { developerPageRelativePath } from '../lib/docRoutes';
import { getPagefindLibVersion } from '../lib/pagefindBundlePath';
import { pagefindToolbarUi, shellUi } from '../lib/uiStrings';
import type { AppLocale } from '../lib/appLocale';
import { ChevronDown } from '@lucide/astro';

interface NavItem {
	/** 相对 `developers/` 的路径，如 `welcome`、`plugin/plugin-overview` */
	path: string;
	title: string;
}

interface NavGroup {
	label: string;
	items: NavItem[];
}

interface Crumb {
	label: string;
	href?: string;
}

interface TocHeading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	locale: AppLocale;
	/** `<html lang>`，如 zh-CN / en */
	htmlLang: string;
	/** Pagefind UI 语言代码，与 `pagefind-config` 的 `lang` 一致 */
	pagefindUiLang: string;
	title: string;
	description?: string;
	sidebarGroups?: NavGroup[];
	/** 当前文档在 `developers/` 下的路径，如 `welcome`、`theme/theme-overview` */
	currentPath?: string;
	noSidebar?: boolean;
	breadcrumbs?: Crumb[];
	headings?: TocHeading[];
	/** 404：中英侧栏目录并存，由 `data-doc-locale` + 首屏脚本按 URL 切换 */
	notFoundDualSidebars?: { zh: NavGroup[]; en: NavGroup[] };
	/** 404：与中英侧栏配套的面包屑文案（单 crumb） */
	notFoundDualCrumbLabels?: { zh: string; en: string };
}

const {
	locale,
	htmlLang,
	pagefindUiLang,
	title,
	description,
	sidebarGroups,
	currentPath,
	noSidebar,
	breadcrumbs,
	headings,
	notFoundDualSidebars,
	notFoundDualCrumbLabels,
} = Astro.props;
const t = shellUi(locale);
const tZh = shellUi('zh');
const tEn = shellUi('en');
const pfToolbar = pagefindToolbarUi(locale);
const siteName = t.siteName;
const railSiteLabel = t.railSiteLabel;
const base = import.meta.env.BASE_URL;

const tocItems = (headings ?? []).filter((h) => h.depth >= 2 && h.depth <= 4);
const pagefindBundle = `${base}pagefind/${getPagefindLibVersion()}/`;
const docHomeHref = developerPageRelativePath(locale, 'welcome');
const pathForLangSwitch = currentPath ?? 'welcome';
const zhDocHref = developerPageRelativePath('zh', pathForLangSwitch);
const enDocHref = developerPageRelativePath('en', pathForLangSwitch);
/** 与当前页同路径的 Markdown 地址：在 pathname 末尾加 `.md`（复制时按需 fetch） */
const mdViewHref = `${Astro.url.pathname.replace(/\/+$/, '')}.md`;
/** 仅开发者内容页带 `currentPath`，用于在点击复制时请求 `.md`，避免把正文塞进 HTML */
const markdownCopyFetchHref = currentPath ? mdViewHref : undefined;
/** F5 整页刷新：`history.scrollRestoration` 不负责恢复滚动；用 sessionStorage 在首帧同步 scrollTo（无 # 时）。后退/前进仍走浏览器，勿设 scrollRestoration=manual */
const docScrollSessionPrefix = 'siyuan-docs:doc-scroll:v1:';
---

<!doctype html>
<html lang={htmlLang} data-doc-locale={notFoundDualSidebars ? 'en' : undefined}>
	<head>
		<meta charset="utf-8" />
		<script src={themeBootUrl}></script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="pagefind-bundle" content={pagefindBundle} />
		<script
			type="application/json"
			id="siyuan-code-copy-i18n"
			is:inline
			set:html={JSON.stringify({
				copyAria: t.copyCodeBlockAria,
				copiedAria: t.copyCodeBlockCopiedAria,
				failedAria: t.copyCodeBlockFailedAria,
			})}
		/>
		{description ? <meta name="description" content={description} /> : null}
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} sizes="any" />
		<title>{title === siteName ? title : `${title} – ${siteName}`}</title>
		<slot name="head-after-title" />
		{
			currentPath ? (
				<>
					<link rel="alternate" hreflang="zh-Hans" href={developerPageRelativePath('zh', currentPath)} />
					<link rel="alternate" hreflang="en" href={developerPageRelativePath('en', currentPath)} />
				</>
			) : null
		}
	</head>
	<body class:list={[{ 'doc-layout': !noSidebar }]}>
		{
			!noSidebar ? (
				<script is:inline define:vars={{ docScrollSessionPrefix }}>
					(function () {
						window.addEventListener('pagehide', function () {
							try {
								sessionStorage.setItem(
									docScrollSessionPrefix + location.pathname + location.search,
									String(window.scrollY || 0),
								);
							} catch (e) {
								/* ignore */
							}
						});
					})();
				</script>
			) : null
		}
		<script src={pagefindLoaderUrl}></script>
		<a class="skip-link" href="#main-content">{t.skipToContent}</a>
		<pagefind-config bundle-path={pagefindBundle} lang={pagefindUiLang} />
		{
			noSidebar ? (
				<>
					<header class="topbar topbar--simple">
						<div class="topbar__inner">
							<a class="brand-lockup" href={docHomeHref}>
								<BrandLogo />
								<span class="brand-lockup__text">{siteName}</span>
							</a>
							<div class="topbar__search-slot" data-pagefind-ignore>
								<PagefindToolbarTrigger searchHint={pfToolbar.searchHint} searchOpenAria={pfToolbar.searchOpenAria} />
							</div>
							<ThemeToggleHint
								themeToggleAria={t.themeToggleAria}
								themeToggleHint={t.themeToggleHint}
								themeKeyT={t.themeKeyT}
							/>
							<nav class="topbar__nav" aria-label={t.topNavAria}>
								<a href={docHomeHref}>{t.topNavDocs}</a>
								<LangSwitcher locale={locale} zhHref={zhDocHref} enHref={enDocHref} t={t} />
								<a href="https://github.com/siyuan-note/siyuan" target="_blank" rel="noopener noreferrer">
									GitHub
								</a>
							</nav>
						</div>
					</header>
					<div id="main-content" class="home-wrap" tabindex="-1" data-pagefind-body>
						<slot />
					</div>
				</>
			) : (
				<div class="doc-app">
					<div class="rail-backdrop" id="rail-backdrop" aria-hidden="true" />
					<aside class="left-rail" id="doc-left-rail" aria-label={t.docNavAria} data-pagefind-ignore>
						<header class="rail-header">
							<a class="brand-lockup brand-lockup--rail" href={docHomeHref}>
								<BrandLogo />
								<span class="brand-lockup__divider" aria-hidden="true" />
								<span class="brand-lockup__text">{railSiteLabel}</span>
							</a>
							<div id="doc-toolbar-slot-rail" class="doc-toolbar-slot doc-toolbar-slot--in-rail"></div>
							<div class="rail-header__actions">
								<div class="rail-header__search-slot">
									<PagefindToolbarTrigger searchHint={pfToolbar.searchHint} searchOpenAria={pfToolbar.searchOpenAria} />
								</div>
							</div>
						</header>
						<div class="rail-body">
							<div
								class="rail-scroll-clip"
								data-rail-scroll-clip
								data-edge-top="0"
								data-edge-bottom="1"
							>
								<div class="rail-scroll">
									{
										notFoundDualSidebars ? (
											<div class="u-doc-locale-stack rail-nav-locale-stack">
												<div class="doc-i18n doc-i18n--zh">
													<RailNavSections
														locale="zh"
														idPrefix="nf-zh"
														sidebarGroups={notFoundDualSidebars.zh}
														railNavAria={tZh.railNavAria}
														currentPath={currentPath}
													/>
												</div>
												<div class="doc-i18n doc-i18n--en">
													<RailNavSections
														locale="en"
														idPrefix="nf-en"
														sidebarGroups={notFoundDualSidebars.en}
														railNavAria={tEn.railNavAria}
														currentPath={currentPath}
													/>
												</div>
											</div>
										) : (
											<nav class="rail-nav" aria-label={t.railNavAria}>
												<ul class="rail-nav__root">
													{
														sidebarGroups?.map((group, gi) => {
															const headId = `rail-nav-head-${gi}`;
															const panelId = `rail-nav-panel-${gi}`;
															return (
																<li class="rail-nav__section" data-state="open">
																	<button
																		type="button"
																		class="rail-nav__trigger"
																		id={headId}
																		aria-expanded="true"
																		aria-controls={panelId}
																	>
																		<span class="rail-nav__trigger-text">{group.label}</span>
																		<ChevronDown class="rail-nav__chev" />
																	</button>
																	<div
																		class="rail-nav__panel"
																		id={panelId}
																		role="region"
																		aria-labelledby={headId}
																	>
																		<ul class="rail-nav__list">
																			{group.items.map((item) => (
																				<li>
																					<a
																						class:list={[
																							'rail-nav__link',
																							{ 'is-active': item.path === currentPath },
																						]}
																						href={developerPageRelativePath(locale, item.path)}
																					>
																						{item.title}
																					</a>
																				</li>
																			))}
																		</ul>
																	</div>
																</li>
															);
														})
													}
												</ul>
											</nav>
										)
									}
								</div>
								<script is:inline>
									(function () {
										document.documentElement.classList.add('doc-rail-scroll-boot');
										/* 与 doc-reading-sync.applyRailActiveNavScroll 同算法；window.__siyuanRailScrollProg 与 TS 共用，避免自动滚动触发 rail-scrollbar--visible */
										var rail = document.querySelector('.rail-scroll');
										var clip = document.querySelector('[data-rail-scroll-clip]');
										if (!rail || !clip) return;
										var links = rail.querySelectorAll('.rail-nav__link.is-active');
										var target = null;
										for (var i = 0; i < links.length; i++) {
											var el = links[i];
											var r = el.getBoundingClientRect();
											if (r.width > 0 && r.height > 0) {
												target = el;
												break;
											}
										}
										function syncEdges() {
											var maxScroll = Math.max(0, rail.scrollHeight - rail.clientHeight);
											var canScroll = maxScroll > 2;
											var st = rail.scrollTop;
											var atTop = st <= 1;
											var atBottom = st >= maxScroll - 1;
											clip.setAttribute('data-edge-top', canScroll && !atTop ? '1' : '0');
											clip.setAttribute('data-edge-bottom', canScroll && !atBottom ? '1' : '0');
										}
										function bumpProgRailScroll() {
											window.__siyuanRailScrollProg =
												(window.__siyuanRailScrollProg || 0) + 1;
										}
										function releaseProgRailScroll() {
											queueMicrotask(function () {
												requestAnimationFrame(function () {
													requestAnimationFrame(function () {
														window.__siyuanRailScrollProg = Math.max(
															0,
															(window.__siyuanRailScrollProg || 0) - 1,
														);
													});
												});
											});
										}
										function applyScroll() {
											if (!target || rail.clientHeight <= 1) {
												syncEdges();
												return;
											}
											var maxScroll = Math.max(0, rail.scrollHeight - rail.clientHeight);
											if (maxScroll <= 0) {
												syncEdges();
												return;
											}
											bumpProgRailScroll();
											try {
												var rr = rail.getBoundingClientRect();
												var tr = target.getBoundingClientRect();
												var yCenterInContent =
													rail.scrollTop + (tr.top - rr.top) + tr.height / 2;
												var nextTop = yCenterInContent - rail.clientHeight / 2;
												if (nextTop < 0) nextTop = 0;
												else if (nextTop > maxScroll) nextTop = maxScroll;
												rail.scrollTop = nextTop;
												syncEdges();
											} finally {
												releaseProgRailScroll();
											}
										}
										applyScroll();
										if (typeof requestAnimationFrame === 'function') {
											requestAnimationFrame(applyScroll);
										}
									})();
								</script>
								<div class="rail-scroll__edge rail-scroll__edge--top" aria-hidden="true" />
								<div class="rail-scroll__edge rail-scroll__edge--bottom" aria-hidden="true" />
							</div>
							<div class="rail-footer">
								{
									notFoundDualSidebars ? (
										<div class="u-doc-locale-stack rail-footer-locale-stack">
											<div class="doc-i18n doc-i18n--zh">
												<ul class="rail-footer__links">
													<li>
														<a
															class:list={[{ 'is-current': currentPath === 'welcome' }]}
															href={developerPageRelativePath('zh', 'welcome')}
														>
															{tZh.railFooterDocs}
														</a>
													</li>
													<li>
														<a href="https://github.com/siyuan-note/bazaar" target="_blank" rel="noopener noreferrer">
															{tZh.railFooterBazaar}
														</a>
													</li>
													<li>
														<a href="https://b3log.org/siyuan" target="_blank" rel="noopener noreferrer">
															{tZh.railFooterOfficial}
														</a>
													</li>
												</ul>
											</div>
											<div class="doc-i18n doc-i18n--en">
												<ul class="rail-footer__links">
													<li>
														<a
															class:list={[{ 'is-current': currentPath === 'welcome' }]}
															href={developerPageRelativePath('en', 'welcome')}
														>
															{tEn.railFooterDocs}
														</a>
													</li>
													<li>
														<a href="https://github.com/siyuan-note/bazaar" target="_blank" rel="noopener noreferrer">
															{tEn.railFooterBazaar}
														</a>
													</li>
													<li>
														<a href="https://b3log.org/siyuan" target="_blank" rel="noopener noreferrer">
															{tEn.railFooterOfficial}
														</a>
													</li>
												</ul>
											</div>
										</div>
									) : (
										<ul class="rail-footer__links">
											<li>
												<a
													class:list={[{ 'is-current': currentPath === 'welcome' }]}
													href={docHomeHref}
												>
													{t.railFooterDocs}
												</a>
											</li>
											<li>
												<a href="https://github.com/siyuan-note/bazaar" target="_blank" rel="noopener noreferrer">
													{t.railFooterBazaar}
												</a>
											</li>
											<li>
												<a href="https://b3log.org/siyuan" target="_blank" rel="noopener noreferrer">
													{t.railFooterOfficial}
												</a>
											</li>
										</ul>
									)
								}
							</div>
						</div>
					</aside>

					<div class="doc-center">
						<div class="content-head" data-pagefind-ignore>
							{
								notFoundDualSidebars && notFoundDualCrumbLabels ? (
									<div class="content-head__breadcrumbs-stack u-doc-locale-stack">
										<nav class="breadcrumbs doc-i18n doc-i18n--zh" aria-label={tZh.breadcrumbsAria}>
											<ol class="breadcrumbs__list">
												<li class="breadcrumbs__item">
													<span class="breadcrumbs__current" aria-current="page">
														{notFoundDualCrumbLabels.zh}
													</span>
												</li>
											</ol>
										</nav>
										<nav class="breadcrumbs doc-i18n doc-i18n--en" aria-label={tEn.breadcrumbsAria}>
											<ol class="breadcrumbs__list">
												<li class="breadcrumbs__item">
													<span class="breadcrumbs__current" aria-current="page">
														{notFoundDualCrumbLabels.en}
													</span>
												</li>
											</ol>
										</nav>
									</div>
								) : (
									<nav class="breadcrumbs" aria-label={t.breadcrumbsAria}>
										<ol class="breadcrumbs__list">
											{breadcrumbs?.map((c, i, arr) => {
												const isLast = i === arr.length - 1;
												return (
													<li class="breadcrumbs__item">
														{c.href ? (
															<a
																class:list={['breadcrumbs__link', { 'breadcrumbs__current': isLast }]}
																href={c.href}
																aria-current={isLast ? 'page' : undefined}
															>
																{c.label}
															</a>
														) : isLast ? (
															<span class="breadcrumbs__current" aria-current="page">
																{c.label}
															</span>
														) : (
															<span class="breadcrumbs__text">{c.label}</span>
														)}
													</li>
												);
											})}
										</ol>
									</nav>
								)
							}
							<div class="content-head__actions">
								<div id="doc-toolbar-slot-content-head" class="doc-toolbar-slot doc-toolbar-slot--in-head">
									<div id="doc-toolbar-floater" class="doc-toolbar-floater">
										<div class="content-head__search-slot content-head__search--when-rail-drawer" data-pagefind-ignore>
											<PagefindToolbarTrigger searchHint={pfToolbar.searchHint} searchOpenAria={pfToolbar.searchOpenAria} />
										</div>
										<LangSwitcher locale={locale} zhHref={zhDocHref} enHref={enDocHref} t={t} />
										<div class="content-head__desktop-only">
											<ThemeToggleHint
												themeToggleAria={t.themeToggleAria}
												themeToggleHint={t.themeToggleHint}
												themeKeyT={t.themeKeyT}
											/>
											<CopyPageMarkdownToolbar
												mdViewHref={mdViewHref}
												markdownCopyFetchHref={markdownCopyFetchHref}
												t={t}
											/>
										</div>
									</div>
								</div>
								<button
									type="button"
									class="rail-menu-trigger"
									id="rail-menu-toggle"
									aria-expanded="false"
									aria-controls="doc-left-rail"
									aria-label={t.railMenuOpenAria}
									data-aria-when-open={t.railMenuCloseAria}
									data-aria-when-closed={t.railMenuOpenAria}
								>
									<span class="rail-menu-trigger__icon" aria-hidden="true">
										<span class="rail-menu-trigger__bar"></span>
										<span class="rail-menu-trigger__bar"></span>
										<span class="rail-menu-trigger__bar"></span>
									</span>
								</button>
							</div>
						</div>
						<div
							class:list={['doc-reading', { 'doc-reading--with-toc': tocItems.length > 0 }]}
						>
							<main id="main-content" class="doc-main" tabindex="-1" data-pagefind-body>
								<slot />
							</main>
							<script is:inline define:vars={{ docScrollSessionPrefix }}>
								(function () {
									var root = document.documentElement;
									var ch = document.querySelector('.content-head');
									if (ch) {
										try {
											root.style.setProperty(
												'--doc-overlay-top',
												Math.ceil(ch.getBoundingClientRect().height) + 'px',
											);
										} catch (e) {
											/* ignore */
										}
									}
									var dc = document.querySelector('.doc-center');
									if (dc) {
										try {
											var r = dc.getBoundingClientRect();
											var vw = window.innerWidth || document.documentElement.clientWidth || 0;
											root.style.setProperty('--doc-content-head-inset-left', r.left + 'px');
											root.style.setProperty(
												'--doc-content-head-inset-right',
												Math.max(0, vw - r.right) + 'px',
											);
										} catch (e) {
											/* ignore */
										}
									}
									try {
										root.style.removeProperty('--doc-toc-fixed-left');
									} catch (e) {
										/* ignore */
									}
									var h = window.location.hash;
									var hasHash = h && h.length >= 2;
									if (!hasHash) {
										try {
											var rawY = sessionStorage.getItem(
												docScrollSessionPrefix + location.pathname + location.search,
											);
											if (rawY != null) {
												var y = parseInt(rawY, 10);
												if (!isNaN(y) && y >= 0) window.scrollTo(0, y);
											}
										} catch (e) {
											/* ignore */
										}
									}
								})();
							</script>
							{tocItems.length > 0 && (
								<aside class="toc-rail" aria-label={t.tocAsideAria} data-pagefind-ignore>
									<div class="toc-rail__container">
										<ul class="toc-rail__list" id="doc-toc-list" style="--top: 0px; --height: 0px;">
											{tocItems.map((h) => (
												<li class:list={[`toc-depth-${h.depth}`]}>
													<a href={`#${h.slug}`}>{h.text}</a>
												</li>
											))}
										</ul>
									</div>
									<script is:inline>
										(function () {
											var root = document.documentElement;
											var dc = document.querySelector('.doc-center');
											var toc = document.querySelector('.toc-rail');
											try {
												if (
													dc &&
													toc &&
													window.matchMedia &&
													window.matchMedia('(min-width: 1000px)').matches &&
													toc.offsetWidth > 0
												) {
													var dcr = dc.getBoundingClientRect();
													root.style.setProperty(
														'--doc-toc-fixed-left',
														Math.round(dcr.right - toc.offsetWidth) + 'px',
													);
												} else {
													root.style.removeProperty('--doc-toc-fixed-left');
												}
											} catch (e) {
												/* ignore */
											}
											var h = window.location.hash;
											if (!h || h.length < 2) return;
											var enc = h.slice(1);
											var id;
											try {
												id = decodeURIComponent(enc);
											} catch (e) {
												id = enc;
											}
											if (
												!window.matchMedia ||
												!window.matchMedia('(min-width: 1000px)').matches
											) {
												return;
											}
											var tocList = document.getElementById('doc-toc-list');
											if (!toc || !tocList) return;
											if (toc.getBoundingClientRect().height < 1) return;
											var links = tocList.querySelectorAll('a[href^="#"]');
											var target = null;
											for (var i = 0; i < links.length; i++) {
												var raw = (links[i].getAttribute('href') || '').replace(/^#/, '');
												if (raw === id) {
													target = links[i];
													break;
												}
											}
											if (!target) return;
											for (var j = 0; j < links.length; j++) {
												links[j].classList.remove('is-active');
												links[j].removeAttribute('aria-current');
											}
											target.classList.add('is-active');
											target.setAttribute('aria-current', 'location');
											var liNode = target.closest('li');
											if (liNode) {
												var listR = tocList.getBoundingClientRect();
												var liR = liNode.getBoundingClientRect();
												var topPx = Math.round(liR.top - listR.top);
												var botPx = Math.round(liR.bottom - listR.top);
												var hPx = Math.max(0, botPx - topPx);
												tocList.style.setProperty('--top', topPx + 'px');
												tocList.style.setProperty('--height', hPx + 'px');
											}
											var maxScroll = Math.max(0, toc.scrollHeight - toc.clientHeight);
											var tr = target.getBoundingClientRect();
											var windowMid =
												(window.innerHeight || document.documentElement.clientHeight || 0) / 2;
											var linkMidViewport = tr.top + tr.height / 2;
											var nextTop = toc.scrollTop + (linkMidViewport - windowMid);
											if (nextTop < 0) nextTop = 0;
											else if (nextTop > maxScroll) nextTop = maxScroll;
											toc.scrollTop = nextTop;
										})();
									</script>
								</aside>
							)}
						</div>
					</div>
				</div>
			)
		}

		<pagefind-modal reset-on-close></pagefind-modal>

		<script type="module" src={shellAfterLoadUrl}></script>
	</body>
</html>
