---
/* 与主题、复制共用 u-floating-hint；hide-shortcut 仅隐藏内置徽章，⌘K / Ctrl+K 仍由 shortcut 绑定 */
---

<div class="u-floating-hint u-floating-hint--pagefind" data-anchored-floating-hint>
	<pagefind-modal-trigger class="pf-trigger-wrap" compact placeholder="" shortcut="mod+k" hide-shortcut />
	<div class="u-floating-hint__layer" data-floating-hint-layer role="tooltip">
		<span class="u-floating-hint__text">搜索</span>
		<kbd class="u-floating-hint__key" data-search-hint-mod>Ctrl</kbd>
		<kbd class="u-floating-hint__key">K</kbd>
	</div>
</div>
