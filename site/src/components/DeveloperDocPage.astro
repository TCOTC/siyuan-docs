---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import { developerDocPath, developerNavGroupKey } from '../lib/developerDocPath';
import { developerPageRelativePath, withBaseUrl } from '../lib/docRoutes';
import { getDeveloperDocsNavGroups } from '../lib/getDeveloperDocsNav';
import { navUi } from '../lib/uiStrings';
import type { AppLocale } from '../lib/appLocale';

interface Props {
	locale: AppLocale;
	doc: CollectionEntry<'docs'>;
}

const { locale, doc } = Astro.props;
const { Content, headings } = await render(doc);

const sidebarGroups = await getDeveloperDocsNavGroups(locale);
const base = import.meta.env.BASE_URL;
const currentPath = developerDocPath(doc);
const ui = navUi(locale);
const groupKey = developerNavGroupKey(doc.id);
const breadcrumbGroupLabel = ui.navGroup[groupKey];
const docHref = withBaseUrl(base, developerPageRelativePath(locale, currentPath));
const breadcrumbs = [{ label: breadcrumbGroupLabel }, { label: doc.data.title, href: docHref }];
const htmlLang = locale === 'zh' ? 'zh-CN' : 'en';
const pagefindUiLang = locale === 'zh' ? 'zh' : 'en';
---

<Shell
	locale={locale}
	htmlLang={htmlLang}
	pagefindUiLang={pagefindUiLang}
	title={doc.data.title}
	description={doc.data.description}
	sidebarGroups={sidebarGroups}
	currentPath={currentPath}
	breadcrumbs={breadcrumbs}
	headings={headings}
>
	<article class="prose">
		<h1>{doc.data.title}</h1>
		<Content />
	</article>
</Shell>
