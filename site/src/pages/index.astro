---
import { developerPageRelativePath } from '../lib/docRoutes';
import indexRedirectUrl from '../scripts/index-redirect.ts?url';

const zhWelcome = developerPageRelativePath('zh', 'welcome');
const enWelcome = developerPageRelativePath('en', 'welcome');
---

<!doctype html>
<html lang="en" data-index-zh={zhWelcome} data-index-en={enWelcome}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Redirecting…</title>
		<link rel="canonical" href={enWelcome} />
		<noscript>
			<meta http-equiv="refresh" content={`0;url=${enWelcome}`} />
		</noscript>
		<script src={indexRedirectUrl}></script>
	</head>
	<body>
		<p>Redirecting to documentation…</p>
		<noscript>
			<p>
				<a href={zhWelcome}>中文文档</a>
				{' · '}
				<a href={enWelcome}>English documentation</a>
			</p>
		</noscript>
	</body>
</html>
