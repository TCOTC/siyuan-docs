---
import { getCollection, render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import { developerDocPath, developerNavGroupLabel } from '../../lib/developerDocPath';
import { getDeveloperDocsNavGroups } from '../../lib/getDeveloperDocsNav';

export async function getStaticPaths() {
	const docs = await getCollection('docs');
	return docs.map((doc) => ({
		params: { slug: developerDocPath(doc) },
		props: { doc },
	}));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);

const sidebarGroups = await getDeveloperDocsNavGroups();

const base = import.meta.env.BASE_URL;
const currentPath = developerDocPath(doc);
const breadcrumbGroup = { label: developerNavGroupLabel(doc.id) };
const breadcrumbs = [
	breadcrumbGroup,
	{ label: doc.data.title, href: `${base}developers/${currentPath}` },
];
---

<Shell
	title={doc.data.title}
	description={doc.data.description}
	sidebarGroups={sidebarGroups}
	currentPath={currentPath}
	breadcrumbs={breadcrumbs}
	headings={headings}
>
	<article class="prose">
		<h1>{doc.data.title}</h1>
		<Content />
	</article>
</Shell>
