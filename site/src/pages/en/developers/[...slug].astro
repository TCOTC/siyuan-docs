---
import { getCollection } from 'astro:content';
import DeveloperDocPage from '../../../components/DeveloperDocPage.astro';
import { appLocaleCode } from '../../../lib/appLocale';
import { developerDocPath } from '../../../lib/developerDocPath';

export async function getStaticPaths() {
	const docs = await getCollection('docs');
	return docs
		.filter((d) => d.id.startsWith(`${appLocaleCode.en}/`))
		.map((doc) => ({
			params: { slug: developerDocPath(doc) },
			props: { doc },
		}));
}

const { doc } = Astro.props;
---

<DeveloperDocPage locale={appLocaleCode.en} doc={doc} />
