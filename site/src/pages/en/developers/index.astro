---
import { appLocaleCode } from '../../../lib/appLocale';
import { redirectHrefForDeveloperDocFolder, siteNotFoundHref } from '../../../lib/developerDocFolderEntry';

const href =
	(await redirectHrefForDeveloperDocFolder(appLocaleCode.en, 'root')) ?? siteNotFoundHref();
if (href.length < 1) throw new Error('[developers/en] 无有效跳转目标');
return Astro.redirect(href);
---
